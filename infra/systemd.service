[Unit]
Description=WG-Gesucht bump bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=__PROJECT_DIR__/.env
ExecStart=__PYTHON_BIN__ __PROJECT_DIR__/main.py
Restart=always
RestartSec=15
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
